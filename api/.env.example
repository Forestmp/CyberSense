# Copia este archivo como .env y completa los valores. Nunca subas .env al repositorio.

# --- Servidor ---
ENV=development
# Orígenes permitidos para CORS, separados por comas (vacío = cualquiera)
CORS_ORIGINS=

# --- Base de datos (Supabase) ---
# Supabase > Project Settings > Database > Connection string > "Session pooler"
# (compatible con IPv4). Sustituye [YOUR-PASSWORD] por la contraseña de la BD.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# Supabase exige SSL. Usa false solo con un PostgreSQL local sin SSL.
DB_SSL=true
DB_POOL_MAX=10

# --- Autenticación ---
# Genera un valor aleatorio largo, p. ej.:
#   python -c "import secrets; print(secrets.token_hex(48))"
JWT_SECRET=cambia-este-valor-por-uno-aleatorio-de-al-menos-32-caracteres
# Vigencia del token en horas
JWT_EXPIRES_HOURS=8
BCRYPT_ROUNDS=12
# Número de proxies delante de la API (Render = 1); el límite de intentos usa la IP real.
TRUST_PROXY=0

# --- Administrador inicial (lo usa `python -m scripts.seed`) ---
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# --- Correo (recuperación de contraseña) ---
# console = no envía; escribe el código en los logs (desarrollo).
# brevo   = envía con la API de Brevo (Render gratuito bloquea SMTP).
MAIL_PROVIDER=console
# Brevo > SMTP & API > API Keys
BREVO_API_KEY=
# Remitente verificado en Brevo (Senders, Domains & Dedicated IPs > Senders)
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=CyberSense
