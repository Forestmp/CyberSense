# Copia este archivo como .env y completa los valores. Nunca subas .env al repositorio.

# --- Servidor ---
PORT=3000
NODE_ENV=development
# Orígenes permitidos para CORS, separados por comas (vacío = cualquiera, solo en desarrollo)
CORS_ORIGINS=

# --- Base de datos (Supabase) ---
# Supabase > Project Settings > Database > Connection string > "Session pooler"
# (compatible con IPv4). Sustituye [YOUR-PASSWORD] por la contraseña de la BD.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# Supabase exige SSL. Usa false solo con un PostgreSQL local sin SSL.
DB_SSL=true
DB_POOL_MAX=10

# --- Autenticación ---
# Genera un valor aleatorio largo, p. ej.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-este-valor-por-uno-aleatorio-de-al-menos-32-caracteres
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12

# --- Administrador inicial (lo usa `npm run db:seed`) ---
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
