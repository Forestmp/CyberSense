{
  "expo": {
    "name": "CyberSense",
    "slug": "cybersense",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.cybersense.app",
      "versionCode": 2
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "CyberSense",
      "shortName": "CyberSense",
      "themeColor": "#0B1F4D",
      "description": "Aprende a identificar riesgos digitales antes de que sea demasiado tarde."
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-font"
    ],
    "scheme": "cybersense",
    "backgroundColor": "#F8FAFC",
    "primaryColor": "#2563EB"
  }
}
